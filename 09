inteiro opcao = 0

       
        enquanto (opcao != 4)
        {
            escreva("\n=== MENU DE ATENDIMENTO ===\n")
            escreva("1 → Ver saldo\n")
            escreva("2 → Realizar depósito\n")
            escreva("3 → Exibir mensagem\n")
            escreva("4 → Encerrar atendimento\n")
            escreva("Escolha uma opção: ")
            leia(opcao)

            
            escolha (opcao)
            {
                caso 1:
                    escreva("\nVocê escolheu: Ver saldo. (Seu saldo atual é de R$ 0,00)\n")
                pare
                
                caso 2:
                    escreva("\nVocê escolheu: Realizar depósito. (Função em desenvolvimento)\n")
                pare
                
                caso 3:
                    escreva("\nAtendimento em andamento\n")
                pare
                
                caso 4:
                    escreva("\nAtendimento encerrado com sucesso. Até logo!\n")
                pare
                
                caso contrario:
                    escreva("\nOpção inválida! Por favor, escolha uma opção de 1 a 4.\n")
            }
        }
    }
